<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      CEF helper-process entitlements. V8's JIT writes executable memory, which
      the hardened runtime (required for notarization) forbids without these.
      Applied to EACH *Helper.app's executable when signing inside-out (deepest
      first), per scripts/bundle.sh's marked extension point.

      Modern upstream Chrome has narrowed the renderer helper to allow-jit alone;
      this broader set matches CEF's documented guidance and is the safe default
      until you confirm the minimal set against your CEF branch.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
