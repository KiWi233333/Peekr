<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      MAIN-APP entitlements for the CEF build (use INSTEAD of
      Resources/Peekr.entitlements only when the Chromium engine is bundled).

      disable-library-validation lets the main process load the downloaded
      Chromium Embedded Framework, which is signed by a different team (or ad-hoc,
      from the CDN) than Peekr. The pure WKWebView app does NOT need this — keep
      it off there; it is a broader relaxation that weakens the "trustworthy"
      posture, so it is scoped to the CEF variant only.

      apple-events is still needed for the open-tab import feature.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
