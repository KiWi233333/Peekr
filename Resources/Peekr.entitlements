<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Entitlements for the main app under the hardened runtime (which
      notarization requires). Sending Apple Events to browsers — the open-tab
      import feature — needs this entitlement once the hardened runtime is on.
      Chromium's JIT relaxations are scoped to each CefSwift Helper bundle; the
      main process does not execute V8 JIT code. The CEF framework is bundled
      and re-signed with the same identity, so library validation stays enabled.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!--
      CEF's unbranded Chromium build stores macOS Touch ID WebAuthn
      credentials in these groups. bundle.sh resolves AppIdentifierPrefix to
      the team ID of the selected signing identity before codesigning.
    -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)org.chromium.Chromium.webauthn</string>
        <string>$(AppIdentifierPrefix)org.chromium.Chromium.webauthn-uvk</string>
    </array>
</dict>
</plist>
